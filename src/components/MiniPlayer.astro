---
import Logo from './Logo.astro';
---

<!--
  La página es una canción: este mini reproductor (el mismo gesto que la app)
  aparece al salir del hero, dice en qué parte vas y su barra avanza con el
  scroll como si sonara Mr. Brightside (3:43). El botón siempre descarga.
-->
<aside class="mini" data-mini aria-label="Progreso de la página y descarga">
  <div class="mini__bar" aria-hidden="true"><span data-mini-progress></span></div>
  <div class="mini__row">
    <span class="mini__art" aria-hidden="true"><Logo class="size-full" /></span>
    <div class="mini__text">
      <span class="mini__title">Syncora</span>
      <span class="mini__section" data-mini-section aria-live="polite">Tu música, sin anuncios</span>
    </div>
    <span class="mini__time" aria-hidden="true"><span data-mini-time>0:00</span> / 3:43</span>
    <a href="#descargar" class="btn btn-light mini__btn" data-mini-download>Descargar</a>
  </div>
</aside>

<style>
  .mini {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: var(--z-player);
    width: min(100% - 24px, 640px);
    translate: -50% calc(100% + 40px);
    border-radius: 22px;
    overflow: hidden;
    background: oklch(0.267 0.027 260 / 0.92);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow:
      0 0 0 1px oklch(1 0 0 / 0.08) inset,
      0 24px 50px -16px oklch(0 0 0 / 0.75);
    transition: translate 500ms var(--ease-out-expo);
  }

  .mini[data-state='on'] {
    translate: -50% 0;
  }

  .mini__bar {
    height: 3px;
    background: oklch(1 0 0 / 0.1);
  }

  .mini__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-ink);
    transform-origin: left;
    scale: 0 1;
  }

  .mini__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.6rem 0.6rem 0.7rem;
  }

  .mini__art {
    flex: none;
    width: 42px;
    height: 42px;
    padding: 6px;
    border-radius: 10px;
    background: var(--color-night);
  }

  .mini__text {
    flex: 1;
    min-width: 0;
    display: grid;
    line-height: 1.25;
  }

  .mini__title {
    font-weight: 800;
    font-stretch: 110%;
  }

  .mini__section {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-ink-2);
    font-size: 0.9rem;
  }

  .mini__time {
    display: none;
    color: var(--color-ink-3);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .mini__btn {
    min-height: 44px;
    padding: 0.65rem 1.15rem;
    font-size: 0.95rem;
  }

  @media (min-width: 640px) {
    .mini__time {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini {
      transition: none;
    }
  }
</style>
