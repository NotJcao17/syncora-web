---
import Logo from './Logo.astro';
import { CONTACT_EMAIL, REPO_URL } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <Logo class="size-10" />
      <span>Syncora Player</span>
    </div>
    <p class="foot__text">
      Proyecto de código abierto bajo licencia GPL-3.0.
      <a href={REPO_URL} rel="noopener">Código en GitHub</a>.
    </p>
    <nav class="foot__links" aria-label="Información legal">
      <a href="/privacidad">Aviso de privacidad</a>
      <a href="/terminos">Términos y aviso legal</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
    <p class="foot__fine">
      Datos de canciones, álbumes y artistas: <a href="https://www.deezer.com" rel="noopener">Deezer</a>.
      Letras: <a href="https://lrclib.net" rel="noopener">LRCLib</a>. Syncora no aloja ni distribuye
      música y no está afiliada a Deezer, Spotify, YouTube, Google ni a ningún otro servicio mencionado
      en esta página; sus marcas pertenecen a sus dueños. Las capturas usan una cuenta de demostración
      con datos de ejemplo. © {year}.
    </p>
  </div>
</footer>

<style>
  .foot {
    padding-block: 3rem calc(6rem + env(safe-area-inset-bottom));
    border-top: 1px solid oklch(1 0 0 / 0.08);
  }

  .foot__grid {
    display: grid;
    gap: 1rem;
  }

  .foot__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.2rem;
  }

  .foot__text,
  .foot__fine {
    color: var(--color-ink-2);
    max-width: 70ch;
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 600;
  }

  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot__fine {
    font-size: 0.9rem;
    color: var(--color-ink-3);
  }

  .foot a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
