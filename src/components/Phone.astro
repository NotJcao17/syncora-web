---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Teléfono Android (marco tipo Pixel: biseles parejos y cámara perforada).
 * Las capturas son reales, de la app en release con el modo demo de Android
 * (12:00, batería llena, sin notificaciones).
 *
 * Todo el marco escala con `cqw` del propio teléfono: se puede poner a
 * cualquier ancho sin recalcular radios ni grosores.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
  /** Pantallas extra apiladas encima, para cambiar de captura con scroll. */
  layers?: { src: ImageMetadata; alt: string; key: string }[];
  sizes?: string;
}

const {
  src,
  alt,
  class: className = '',
  eager = false,
  layers = [],
  sizes = '(min-width: 1024px) 360px, 72vw',
} = Astro.props;
const widths = [320, 480, 720];
---

<div class:list={['phone', className]}>
  <div class="phone__body">
    <div class="phone__screen">
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="phone__img"
        data-screen="base"
      />
      {
        layers.map((layer) => (
          <Picture
            src={layer.src}
            alt={layer.alt}
            formats={['avif', 'webp']}
        fallbackFormat="webp"
            widths={widths}
            sizes={sizes}
            loading="lazy"
            class="phone__img phone__img--layer"
            data-screen={layer.key}
          />
        ))
      }
      <span class="phone__glare" aria-hidden="true"></span>
    </div>
    <span class="phone__camera" aria-hidden="true"></span>
  </div>
  <span class="phone__key phone__key--power" aria-hidden="true"></span>
  <span class="phone__key phone__key--volume" aria-hidden="true"></span>
</div>

<style>
  .phone {
    container-type: inline-size;
    position: relative;
    width: 100%;
    /* pantalla 1084 × 2412 más el bisel */
    aspect-ratio: 1124 / 2452;
  }

  .phone__body {
    position: absolute;
    inset: 0;
    border-radius: 13cqw;
    padding: 1.8cqw;
    background:
      linear-gradient(145deg, oklch(0.36 0.012 270) 0%, oklch(0.16 0.01 270) 38%, oklch(0.12 0.01 270) 70%, oklch(0.3 0.012 270) 100%);
    box-shadow:
      0 0 0 0.35cqw oklch(0.45 0.01 270 / 0.55) inset,
      0 0 0 1px oklch(0 0 0 / 0.6),
      0 4cqw 10cqw -2cqw oklch(0 0 0 / 0.65),
      0 18cqw 40cqw -14cqw oklch(0.585 0.204 277.1 / 0.35);
  }

  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 11.4cqw;
    background: var(--color-night);
    isolation: isolate;
  }

  .phone__screen :global(picture),
  .phone__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .phone__screen :global(.phone__img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: top;
  }

  .phone__screen :global(picture:has(.phone__img--layer)) {
    position: absolute;
    inset: 0;
  }

  .phone__screen :global(.phone__img--layer) {
    opacity: 0;
  }

  .phone__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, oklch(1 0 0 / 0.07) 0%, oklch(1 0 0 / 0) 32%);
    z-index: 2;
  }

  .phone__camera {
    position: absolute;
    top: 3.7cqw;
    left: 50%;
    width: 3.3cqw;
    height: 3.3cqw;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, oklch(0.35 0.03 260), oklch(0.08 0 0) 60%);
    box-shadow: 0 0 0 0.5cqw oklch(0.05 0 0);
    z-index: 3;
  }

  .phone__key {
    position: absolute;
    right: -0.9cqw;
    width: 1cqw;
    border-radius: 0 1cqw 1cqw 0;
    background: linear-gradient(90deg, oklch(0.2 0.01 270), oklch(0.32 0.012 270));
  }
  .phone__key--power {
    top: 22%;
    height: 9%;
  }
  .phone__key--volume {
    top: 34%;
    height: 15%;
  }
</style>
