---
import Logo from './Logo.astro';
import { REPO_URL } from '../data/site';
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a href="#" class="nav__brand" aria-label="Syncora, inicio de la página">
      <span class="nav__logo" data-nav-logo><Logo class="size-full" /></span>
      <span class="nav__word">Syncora</span>
    </a>
    <nav aria-label="Secciones" class="nav__links">
      <a href="#funciones">Funciones</a>
      <a href="#pc">En tu PC</a>
      <a href="#preguntas">Preguntas</a>
    </nav>
    <!-- El número de estrellas lo pone scripts/download.ts desde la API de GitHub. -->
    <a href={REPO_URL} class="nav__star" rel="noopener" aria-label="Danos una estrella en GitHub">
      <svg viewBox="0 0 16 16" class="nav__star-gh" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
      <span class="nav__star-label">
        <svg viewBox="0 0 16 16" class="nav__star-icon" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path></svg>
        Star us
      </span>
      <span class="nav__star-count" data-star-count hidden></span>
    </a>
    <a href="#descargar" class="btn btn-light nav__cta">Descargar</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top);
    transition:
      translate 400ms var(--ease-out-quint),
      background-color 300ms var(--ease-out-quint);
  }

  .nav[data-state='solid'] {
    background: oklch(0.228 0.022 269.1 / 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 oklch(1 0 0 / 0.06);
  }

  .nav[data-state='hidden'] {
    translate: 0 -110%;
  }

  .nav__row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-weight: 800;
    font-stretch: 115%;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .nav__logo {
    display: block;
    width: 34px;
    height: 34px;
  }

  .nav__links {
    display: none;
    gap: 2rem;
    font-weight: 600;
    color: var(--color-ink-2);
  }

  .nav__links a {
    transition: color 160ms var(--ease-out-quint);
  }

  .nav__links a:hover {
    color: var(--color-ink);
  }

  /* Botón de GitHub: en móvil solo el ícono, desde 640 px con "Star us" y el conteo. */
  .nav__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    margin-right: -0.75rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: oklch(1 0 0 / 0.06);
    box-shadow: 0 0 0 1px oklch(1 0 0 / 0.12) inset;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    transition: background-color 160ms var(--ease-out-quint);
  }

  .nav__star:hover {
    background: oklch(1 0 0 / 0.11);
  }

  .nav__star-gh {
    flex: none;
    width: 20px;
    height: 20px;
  }

  .nav__star-label,
  .nav__star-count {
    display: none;
  }

  .nav__star-icon {
    width: 14px;
    height: 14px;
    color: oklch(0.85 0.15 90);
  }

  .nav__star-count {
    padding-left: 0.5rem;
    border-left: 1px solid oklch(1 0 0 / 0.15);
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .nav__star {
      padding: 0 0.95rem;
    }

    .nav__star-label {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .nav__star-count:not([hidden]) {
      display: inline;
    }
  }

  @media (hover: none) {
    .nav__star:hover {
      background: oklch(1 0 0 / 0.06);
    }
  }

  .nav__cta {
    min-height: 44px;
    padding: 0.7rem 1.2rem;
    font-size: 0.95rem;
  }

  @media (min-width: 860px) {
    .nav__links {
      display: flex;
    }
  }
</style>
